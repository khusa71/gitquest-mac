{
  "name": "gitquest-mac",
  "productName": "GitQuest",
  "version": "0.1.0",
  "private": true,
  "description": "Learn git on your Mac with real git, a real terminal and live diagrams",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "rebuild": "electron-rebuild -f -w node-pty",
    "build:speech": "node scripts/build-speech.mjs",
    "postinstall": "node scripts/patch-dev-plist.mjs",
    "dist": "npm run build:speech && electron-vite build && electron-builder --mac"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "kokoro-js": "^1.2.1",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
